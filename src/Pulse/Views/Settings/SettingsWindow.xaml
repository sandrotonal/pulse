<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Pulse.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pulse Ayarları">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="SettingsRoot" Padding="28,0,28,22" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="SettingsText" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="SettingsSecondary" Color="#FF68686E" />
            <SolidColorBrush x:Key="SettingsAccent" Color="#FF248A3D" />
            <SolidColorBrush x:Key="SettingsDivider" Color="#26000000" />
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondary}" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Margin" Value="0,20,0,7" />
            </Style>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SettingsDivider}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent">
            <TextBlock Text="PULSE  /  AYARLAR" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90"
                       Foreground="{ThemeResource SettingsSecondary}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,18,0,14">
            <TextBlock Text="Ayarlar" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource SettingsText}" />
            <TextBlock Text="Pulse deneyimini kendine göre düzenle." FontSize="14" Foreground="{ThemeResource SettingsSecondary}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="0">
                <TextBlock Text="DAVRANIŞ" Style="{StaticResource SectionTitleStyle}" Margin="0,7,0,7" />
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Windows ile başlat" Style="{StaticResource SettingLabelStyle}" />
                    <ToggleSwitch Grid.Column="1" Width="50" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  OnContent="" OffContent="" IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                  AutomationProperties.Name="Windows ile başlat" />
                </Grid>
                <Border Style="{StaticResource DividerStyle}" />
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                    <TextBlock Text="İşlemden sonra otomatik küçült" Style="{StaticResource SettingLabelStyle}" />
                    <ToggleSwitch Grid.Column="1" Width="50" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  OnContent="" OffContent="" IsOn="{Binding AutoCollapse, Mode=TwoWay}"
                                  AutomationProperties.Name="İşlemden sonra otomatik küçült" />
                </Grid>
                <Border Style="{StaticResource DividerStyle}" />
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                    <TextBlock Text="İleri ve geri sarma kontrolleri" Style="{StaticResource SettingLabelStyle}" />
                    <ToggleSwitch Grid.Column="1" Width="50" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  OnContent="" OffContent="" IsOn="{Binding ShowSeekControls, Mode=TwoWay}"
                                  AutomationProperties.Name="İleri ve geri sarma kontrollerini göster" />
                </Grid>
                <Border Style="{StaticResource DividerStyle}" />
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Parça değişim bildirimleri" Style="{StaticResource SettingLabelStyle}" />
                    <ToggleSwitch Grid.Column="1" Width="50" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  OnContent="" OffContent="" IsOn="{Binding NotificationsPaused, Mode=TwoWay}"
                                  AutomationProperties.Name="Parça değişim bildirimlerini duraklat" />
                </Grid>

                <TextBlock Text="GÖRÜNÜM" Style="{StaticResource SectionTitleStyle}" />
                <Grid MinHeight="52">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="152" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Açık veya koyu" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Sistem" /><ComboBoxItem Content="Koyu" /><ComboBoxItem Content="Açık" />
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource DividerStyle}" />
                <Grid MinHeight="52">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="152" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Hareket" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding AnimationIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Az" /><ComboBoxItem Content="Dengeli" /><ComboBoxItem Content="Akıcı" />
                    </ComboBox>
                </Grid>
                <TextBlock Text="Kısa, hafif geçişler. Az hareket seçeneği animasyonları kapatır."
                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SettingsSecondary}" Margin="0,2,0,8" />

                <TextBlock Text="KONUM VE BOYUT" Style="{StaticResource SectionTitleStyle}" />
                <Grid MinHeight="34">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Üst kenar boşluğu" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding TopOffsetLabel}" FontSize="12" Foreground="{ThemeResource SettingsSecondary}" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="0" Maximum="80" StepFrequency="1" Foreground="{ThemeResource SettingsAccent}"
                        Value="{Binding TopOffset, Mode=TwoWay}" AutomationProperties.Name="Üst kenar boşluğu" />
                <Grid MinHeight="34" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Ada boyutu" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding IslandScaleLabel}" FontSize="12" Foreground="{ThemeResource SettingsSecondary}" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="80" Maximum="125" StepFrequency="5" Foreground="{ThemeResource SettingsAccent}"
                        Value="{Binding IslandScale, Mode=TwoWay}" AutomationProperties.Name="Ada boyutu" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{ThemeResource SettingsAccent}" FontSize="12" Margin="0,10,0,0" />
    </Grid>
</Window>
