<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Pulse.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pulse Ayarları">
    <Grid x:Name="SettingsRoot" Padding="28,0,28,22" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="SettingsText" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="SettingsSecondary" Color="#FF68686E" />
            <SolidColorBrush x:Key="SettingsAccent" Color="#FF248A3D" />
            <SolidColorBrush x:Key="SettingsDivider" Color="#26000000" />
            <SolidColorBrush x:Key="SettingsCard" Color="#0D808080" />
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondary}" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Margin" Value="0,20,0,7" />
            </Style>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SettingsDivider}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent">
            <TextBlock Text="PULSE  /  AYARLAR" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90"
                       Foreground="{ThemeResource SettingsSecondary}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="48" Height="48" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Ayarlar" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource SettingsText}" />
                <TextBlock Text="Pulse deneyimini kendine göre düzenle." FontSize="13" Foreground="{ThemeResource SettingsSecondary}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="0">
                <!-- 1. DİNAMİK ADA DAVRANIŞI -->
                <TextBlock Text="DİNAMİK ADA DAVRANIŞI" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,2,16,2" Margin="0,0,0,16">
                    <StackPanel Spacing="0">
                        <!-- Hover Expand -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="İmleç üzerine geldiğinde genişlet" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Kompakt adanın fareyle üzerine gelindiğinde akıcı genişlemesini sağlar." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding EnableHoverExpand, Mode=TwoWay}"
                                          AutomationProperties.Name="İmleç üzerine geldiğinde genişlet" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Auto Collapse -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="İşlemden sonra otomatik küçült" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Fare çekildikten sonra adayı otomatik olarak kompakt moda alır." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding AutoCollapse, Mode=TwoWay}"
                                          AutomationProperties.Name="İşlemden sonra otomatik küçült" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Equalizer Waves -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Canlı ritim ekolayzırı" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Kompakt adada çalan parçanın ritmine uygun dalga barları gösterir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding ShowEqualizer, Mode=TwoWay}"
                                          AutomationProperties.Name="Canlı ritim ekolayzırı" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. MEDYA VE KONTROLLER -->
                <TextBlock Text="MEDYA VE KONTROLLER" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,2,16,2" Margin="0,0,0,16">
                    <StackPanel Spacing="0">
                        <!-- Dynamic Artwork Tint -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Albüm kapağına göre dinamik renk tonlaması" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Adanın arka planını ve butonlarını albüm kapağı renkleriyle canlandırır." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding DynamicColorTint, Mode=TwoWay}"
                                          AutomationProperties.Name="Albüm kapağına göre dinamik renk tonlaması" />
                        </Grid>

                        <!-- Artwork Tint Strength -->
                        <StackPanel Spacing="4" Margin="0,2,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Kapak rengi yoğunluğu" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ArtworkTintStrengthLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SettingsAccent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Albüm kapağının ada arka planına yansıma şiddeti. Düşük değerler daha sakin, yüksek değerler daha canlı bir ton verir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" TextWrapping="Wrap" />
                            <Slider Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding DynamicColorTint}" Foreground="{ThemeResource SettingsAccent}"
                                    Value="{Binding ArtworkTintStrength, Mode=TwoWay}" AutomationProperties.Name="Kapak rengi yoğunluğu" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Seek Controls -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="İleri ve geri sarma kontrolleri" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Oynatıcı kartında 15 saniye geri ve ileri atlama butonlarını gösterir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding ShowSeekControls, Mode=TwoWay}"
                                          AutomationProperties.Name="İleri ve geri sarma kontrollerini göster" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Notifications -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Parça değişim bildirimleri" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Yeni parça başladığında adanın kısa bir bilgilendirme göstermesini sağlar." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding NotificationsPaused, Mode=TwoWay}"
                                          AutomationProperties.Name="Parça değişim bildirimleri" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. BİLDİRİMLER -->
                <TextBlock Text="BİLDİRİMLER" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,2,16,2" Margin="0,0,0,16">
                    <StackPanel Spacing="0">
                        <!-- Audio HUD -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Ses değişimi göstergesi" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Ses donanım tuşlarıyla veya başka uygulamalardan değiştiğinde adada kısa bir gösterge çıkarır." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding AudioNotifications, Mode=TwoWay}"
                                          AutomationProperties.Name="Ses değişimi göstergesi" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Power -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Pil ve güç olayları" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Şarj bağlandığında ve pil azaldığında adada bildirim gösterir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding PowerNotifications, Mode=TwoWay}"
                                          AutomationProperties.Name="Pil ve güç olayları" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Downloads -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="İndirme bildirimleri" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="İndirilenler klasörüne tamamlanan her dosya için adada kısa bir bildirim gösterir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding DownloadNotifications, Mode=TwoWay}"
                                          AutomationProperties.Name="İndirme bildirimleri" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 4. GÖRÜNÜM VE ANİMASYON -->
                <TextBlock Text="GÖRÜNÜM VE ANİMASYON" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,6,16,6" Margin="0,0,0,16">
                    <StackPanel Spacing="0">
                        <!-- Theme -->
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="152" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Görünüm teması" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Arayüz renk temasını seçin." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="Sistem" /><ComboBoxItem Content="Koyu" /><ComboBoxItem Content="Açık" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Motion -->
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="152" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Hareket akıcılığı" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Geçiş ve yaylanma animasyonlarının dinamizmi." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding AnimationIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="Az" /><ComboBoxItem Content="Dengeli" /><ComboBoxItem Content="Akıcı" />
                            </ComboBox>
                        </Grid>

                        <!-- Motion Speed -->
                        <StackPanel Spacing="4" Margin="0,2,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Animasyon hızı" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding MotionSpeedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SettingsAccent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Geçişlerin genel hızı. Yüksek değerler daha çevik, düşük değerler daha sakin bir akış verir." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" TextWrapping="Wrap" />
                            <Slider Minimum="70" Maximum="140" StepFrequency="5" Foreground="{ThemeResource SettingsAccent}"
                                    Value="{Binding MotionSpeed, Mode=TwoWay}" AutomationProperties.Name="Animasyon hızı" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Glass effect -->
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Cam efekti (Glassmorphism)" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="Adanın arkasındaki masaüstünü yakalayıp bulanıklaştırarak gerçek cam (frost) efekti uygular." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          OnContent="" OffContent="" IsOn="{Binding UseTransparency, Mode=TwoWay}"
                                          AutomationProperties.Name="Cam efekti" />
                        </Grid>

                        <!-- Transparency Strength -->
                        <StackPanel Spacing="4" Margin="0,2,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Saydamlık" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TransparencyLevelLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SettingsAccent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Cam efektinin şeffaflığı. 0% opak, 100% en saydam görünüm." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" TextWrapping="Wrap" />
                            <Slider Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding UseTransparency}" Foreground="{ThemeResource SettingsAccent}"
                                    Value="{Binding TransparencyLevel, Mode=TwoWay}" AutomationProperties.Name="Saydamlık" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. KONUM VE BOYUT -->
                <TextBlock Text="KONUM VE BOYUT" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,10,16,12" Margin="0,0,0,16">
                    <StackPanel Spacing="10">
                        <!-- Top Offset -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Ekran üst kenar boşluğu (Floating Gap)" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TopOffsetLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SettingsAccent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Adanın ekranın üst kenarından olan mesafesini canlı olarak ayarlar." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            <Slider Minimum="0" Maximum="80" StepFrequency="1" Foreground="{ThemeResource SettingsAccent}"
                                    Value="{Binding TopOffset, Mode=TwoWay}" AutomationProperties.Name="Ekran üst kenar boşluğu" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource DividerStyle}" />

                        <!-- Scale -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Ada ölçeği" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding IslandScaleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SettingsAccent}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Dinamik adanın genel boyut oranını ayarlar." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                            <Slider Minimum="80" Maximum="125" StepFrequency="5" Foreground="{ThemeResource SettingsAccent}"
                                    Value="{Binding IslandScale, Mode=TwoWay}" AutomationProperties.Name="Ada boyutu" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. SİSTEM -->
                <TextBlock Text="SİSTEM" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                <Border Background="{ThemeResource SettingsCard}" BorderBrush="{ThemeResource SettingsDivider}" BorderThickness="1" CornerRadius="12" Padding="16,2,16,2" Margin="0,0,0,16">
                    <Grid MinHeight="54">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="Windows ile başlat" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="Windows açıldığında Pulse otomatik olarak başlasın." FontSize="12" Foreground="{ThemeResource SettingsSecondary}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      OnContent="" OffContent="" IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                      AutomationProperties.Name="Windows ile başlat" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{ThemeResource SettingsAccent}" FontSize="12" Margin="0,10,0,0" />
    </Grid>
</Window>
