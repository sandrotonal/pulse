<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Pulse.Views.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pulse.Controls"
    xmlns:winuiex="using:WinUIEx"
    Title="Pulse Dynamic Island">

    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop TintColor="Transparent" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot"
          Width="560" Height="306"
          Background="{x:Null}"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">

        <Grid.Resources>
            <!-- Reference Dark Glass palette -->
            <SolidColorBrush x:Key="IslandBackground" Color="#F20B1018" />
            <SolidColorBrush x:Key="IslandSolidSurface" Color="#FF0B1018" />
            <SolidColorBrush x:Key="IslandBorder"     Color="#33FFFFFF" />
            <SolidColorBrush x:Key="PrimaryText"      Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryText"    Color="#FFA4ABB6" />
            <SolidColorBrush x:Key="Accent"           Color="#FF007AFF" />
            <SolidColorBrush x:Key="SeekAccent"       Color="#FF007AFF" />
            <SolidColorBrush x:Key="PlayButtonBackground" Color="#FF007AFF" />
            <SolidColorBrush x:Key="PlayButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PillControlBackground" Color="#24FFFFFF" />

            <!-- Monochrome slider palette (Apple Control Center style) -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6FFFFFF" />

            <!-- Clean base button style -->
            <Style x:Key="IslandButtonStyle" TargetType="Button">
                <Setter Property="Background"           Value="Transparent" />
                <Setter Property="Foreground"           Value="{ThemeResource SecondaryText}" />
                <Setter Property="BorderThickness"      Value="0" />
                <Setter Property="Padding"              Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PrimaryText}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource IslandSolidSurface}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.72" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular header button style (bare glyph, Apple live-activity chrome) -->
            <Style x:Key="CircularHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="28" />
                <Setter Property="Height"       Value="28" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background"   Value="Transparent" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>

            <!-- Transport capsule button style (-15 and +15) -->
            <Style x:Key="TransportCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="44" />
                <Setter Property="Height"       Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background"   Value="{ThemeResource PillControlBackground}" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>

            <!-- Transport navigation button style (Previous / Next) -->
            <Style x:Key="TransportNavButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="36" />
                <Setter Property="Height"       Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background"   Value="Transparent" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>

            <!-- Play/Pause circular button style -->
            <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="48" />
                <Setter Property="Height"       Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Background"   Value="{ThemeResource PlayButtonBackground}" />
                <Setter Property="Foreground"   Value="{ThemeResource PlayButtonForeground}" />
            </Style>
        </Grid.Resources>

        <!-- Micro notch anchor shown when island is hidden (48x16 hit target wrapping 48x6 visual pill) -->
        <Border x:Name="HiddenAnchor"
                Width="48" Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Background="Transparent"
                Visibility="Collapsed"
                AutomationProperties.Name="Gizli adayı göster"
                PointerEntered="OnHiddenAnchorPointerEntered"
                PointerReleased="OnHiddenAnchorPointerReleased">
            <ToolTipService.ToolTip>
                <ToolTip Content="Pulse Dynamic Island'ı Göster" />
            </ToolTipService.ToolTip>
            <Border x:Name="HiddenAnchorPill"
                    Width="48" Height="6"
                    CornerRadius="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource IslandBorder}"
                    Opacity="0.6" />
        </Border>

        <!-- Dynamic Island Surface Pill / Card (fixed host bounds; GPU Composition clip shapes the pill with zero XAML reflow) -->
        <Grid x:Name="Surface"
              Width="560" Height="300"
              Margin="0,3,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="{x:Null}"
              PointerEntered="OnPointerEntered"
              PointerExited="OnPointerExited"
              PointerPressed="OnSurfacePointerPressed"
              PointerReleased="OnSurfacePointerReleased"
              PointerCanceled="OnSurfacePointerCanceled"
              PointerCaptureLost="OnSurfacePointerCaptureLost"
              PointerWheelChanged="OnSurfacePointerWheelChanged">

            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Genişlet / Daralt" Click="OnToggleExpandedClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Adayı Gizle" Click="OnHideIslandClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />

                    <!-- Test ve Demo Modları -->
                    <MenuFlyoutSubItem Text="Test ve Demo Modları">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Çift Kapsül (Split Island) Modunu Başlat / Kapat" Command="{Binding ToggleSplitIslandDemoCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Müzik Simülatörü (Test Şarkısı Çal / Durdur)" Command="{Binding ToggleDemoTrackCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D6;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>

                    <!-- Odak Sayacı (Pomodoro) -->
                    <MenuFlyoutSubItem Text="Odak Sayacı (Pomodoro)">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE916;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Başlat (25 Dk)" Command="{Binding StartFocusTimerCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Duraklat / Devam Et" Command="{Binding ToggleFocusTimerCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Sıfırla" Command="{Binding ResetFocusTimerCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>

                    <!-- Bildirim Test Simülatörü -->
                    <MenuFlyoutSubItem Text="Bildirim Simülatörü">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEA8F;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Düşük Pil Uyarısı (%15)" Command="{Binding TestBatteryNotificationCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEBA0;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Bluetooth Kulaklık Bağlandı" Command="{Binding TestBluetoothNotificationCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE702;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Ekran Görüntüsü Kaydedildi" Command="{Binding TestScreenshotNotificationCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE722;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Dosya İndirme İlerlemesi" Command="{Binding TestFileProgressCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Ayarlar" Click="OnSettingsClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Grid x:Name="PillMaskHost"
                  Width="560" Height="300"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Background="{x:Null}">

                <!-- Backdrop & Liquid-Glass layers: non-hit-testable and clipped on the GPU by PillMaskHost -->
                <Border x:Name="PillBackdrop"
                        Width="560" Height="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{ThemeResource IslandBackground}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        IsHitTestVisible="False">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Liquid-Glass frost layer: samples + blurs the real desktop behind the island -->
                        <Rectangle x:Name="FrostLayer"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsHitTestVisible="False" />

                        <!-- Live album tint over the neutral blur. Keeping the tint separate
                             lets track changes recolor the glass instantly without re-capturing
                             the desktop (which briefly hides the window and blinks). -->
                        <Rectangle x:Name="FrostTintLayer"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsHitTestVisible="False" />

                        <!-- Specular sheen scaled on GPU via Composition Visual.Scale -->
                        <Rectangle x:Name="FrostSheen"
                                   Height="18"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="FrostSheenTopStop" Color="#2EFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- GPU-clipped 1px Fresnel specular rim synced every frame with surface shape -->
                        <Border x:Name="FrostRimHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- 01 & 02: COMPACT VIEW (Capsule mode: 216-268 x 40 scaled synchronously by IslandScale; sized per state, never per-frame) -->
                <Grid x:Name="CompactView"
                      Width="216" Height="40"
                      Opacity="1"
                      Background="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Padding="12,0,12,0">

                    <!-- Idle: live clock/date + weather strip; brand fallback when all info is off -->
                    <Grid x:Name="IdleContent"
                          Visibility="{Binding CustomIdleVisibility}"
                          Margin="4,0,4,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel x:Name="IdleSmartPanel"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IdleSmartVisibility}">
                            <StackPanel x:Name="IdleClockStack"
                                        MinWidth="52"
                                        Spacing="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IdleClockStackVisibility}">
                                <TextBlock x:Name="IdleClockBlock"
                                           Text="{Binding IdleClockText}"
                                           FontSize="15" FontWeight="SemiBold"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{ThemeResource PrimaryText}"
                                           Visibility="{Binding IdleClockVisibility}" />
                                <TextBlock x:Name="IdleDateBlock"
                                           Text="{Binding IdleDateText}"
                                           FontSize="9.5" FontWeight="Medium"
                                           LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource PrimaryText}"
                                           Opacity="0.72"
                                           Visibility="{Binding IdleDateVisibility}" />
                            </StackPanel>

                            <Border x:Name="IdleDivider"
                                    Width="1" Height="18"
                                    Background="{ThemeResource PrimaryText}"
                                    Opacity="0.24"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IdleDividerVisibility}" />

                            <StackPanel x:Name="IdleWeatherStack"
                                        MinWidth="52"
                                        Spacing="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IdleWeatherVisibility}"
                                        Opacity="{Binding IdleWeatherOpacity}"
                                        ToolTipService.ToolTip="{Binding IdleWeatherTooltip}">
                                <StackPanel x:Name="IdleWeatherHeader"
                                            Height="17"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Viewbox x:Name="IdleWeatherIconBox"
                                             Width="13.5" Height="13.5"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center">
                                        <Grid Width="16" Height="16">
                                            <Canvas x:Name="WeatherIconClearDay" Width="16" Height="16" Visibility="Collapsed">
                                                <Ellipse Canvas.Left="4.8" Canvas.Top="4.8" Width="6.4" Height="6.4" Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" />
                                                <Path Data="M 8,1.5 L 8,3.2 M 8,12.8 L 8,14.5 M 1.5,8 L 3.2,8 M 12.8,8 L 14.5,8 M 3.4,3.4 L 4.6,4.6 M 12.6,3.4 L 11.4,4.6 M 3.4,12.6 L 4.6,11.4 M 12.6,12.6 L 11.4,11.4"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconClearNight" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 8.2,2.7 A 5.2,5.2 0 1 0 13.3,7.9 A 3.9,3.9 0 0 1 8.2,2.7 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                                <Ellipse Canvas.Left="11.4" Canvas.Top="2.6" Width="1.7" Height="1.7" Fill="{ThemeResource PrimaryText}" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconPartlyCloudyDay" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 5.0,2.1 L 5.0,2.9 M 2.2,3.4 L 2.8,4.0 M 1.3,6.2 L 2.1,6.2 M 7.8,3.4 L 7.2,4.0 M 3.2,8.1 A 2.5,2.5 0 1 1 7.2,5.0"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Path Data="M 5.4,13.2 L 12.2,13.2 C 13.5,13.2 14.5,12.2 14.5,10.9 C 14.5,9.7 13.6,8.7 12.4,8.6 C 12.0,6.9 10.5,5.7 8.7,5.7 C 6.8,5.7 5.3,7.1 5.1,8.9 C 4.0,9.1 3.2,10.0 3.2,11.1 C 3.2,12.3 4.2,13.2 5.4,13.2 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconPartlyCloudyNight" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 11.8,1.7 A 2.4,2.4 0 1 0 14.2,4.1 A 1.85,1.85 0 0 1 11.8,1.7 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.25" StrokeLineJoin="Round" />
                                                <Path Data="M 4.0,13.2 L 10.4,13.2 C 11.6,13.2 12.6,12.2 12.6,11.0 C 12.6,9.8 11.7,8.9 10.6,8.8 C 10.2,7.1 8.8,6.0 7.0,6.0 C 5.2,6.0 3.7,7.3 3.5,9.1 C 2.5,9.3 1.8,10.1 1.8,11.1 C 1.8,12.3 2.8,13.2 4.0,13.2 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconCloudy" Width="16" Height="16" Visibility="Visible">
                                                <Path Data="M 4.4,11.8 L 11.8,11.8 C 13.1,11.8 14.1,10.8 14.1,9.5 C 14.1,8.3 13.2,7.3 12.0,7.2 C 11.6,5.3 9.9,4.0 8.0,4.0 C 5.9,4.0 4.2,5.6 4.0,7.6 C 2.8,7.8 1.9,8.8 1.9,10.0 C 1.9,11.0 3.0,11.8 4.4,11.8 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconFog" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 4.4,8.6 L 11.8,8.6 C 13.0,8.6 13.9,7.7 13.9,6.6 C 13.9,5.6 13.1,4.7 12.1,4.6 C 11.7,3.2 10.3,2.2 8.6,2.2 C 6.7,2.2 5.2,3.5 5.0,5.1 C 3.8,5.2 2.9,6.1 2.9,7.1 C 2.9,8.0 3.6,8.6 4.4,8.6 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                                <Path Data="M 2.5,11.1 L 13.5,11.1 M 4.2,13.6 L 11.8,13.6"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconRain" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 4.4,9.5 L 11.8,9.5 C 13.0,9.5 14.0,8.6 14.0,7.4 C 14.0,6.3 13.1,5.4 12.0,5.3 C 11.6,3.6 10.0,2.3 8.1,2.3 C 6.0,2.3 4.3,3.8 4.1,5.7 C 3.0,5.9 2.1,6.8 2.1,7.9 C 2.1,8.8 3.1,9.5 4.4,9.5 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                                <Path Data="M 5.4,11.5 L 4.5,13.9 M 8.2,11.5 L 7.3,13.9 M 11.0,11.5 L 10.1,13.9"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconHeavyRain" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 4.4,9.2 L 11.8,9.2 C 13.0,9.2 14.0,8.3 14.0,7.1 C 14.0,6.0 13.1,5.1 12.0,5.0 C 11.6,3.3 10.0,2.0 8.1,2.0 C 6.0,2.0 4.3,3.5 4.1,5.4 C 3.0,5.6 2.1,6.5 2.1,7.6 C 2.1,8.5 3.1,9.2 4.4,9.2 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                                <Path Data="M 4.5,11.1 L 3.4,14.2 M 7.0,11.1 L 5.9,14.2 M 9.5,11.1 L 8.4,14.2 M 12.0,11.1 L 10.9,14.2"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconSnow" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 4.4,9.4 L 11.8,9.4 C 13.0,9.4 14.0,8.5 14.0,7.3 C 14.0,6.2 13.1,5.3 12.0,5.2 C 11.6,3.5 10.0,2.2 8.1,2.2 C 6.0,2.2 4.3,3.7 4.1,5.6 C 3.0,5.8 2.1,6.7 2.1,7.8 C 2.1,8.7 3.1,9.4 4.4,9.4 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                                <Ellipse Canvas.Left="4.1" Canvas.Top="11.3" Width="2.0" Height="2.0" Fill="{ThemeResource PrimaryText}" />
                                                <Ellipse Canvas.Left="7.1" Canvas.Top="12.6" Width="2.0" Height="2.0" Fill="{ThemeResource PrimaryText}" />
                                                <Ellipse Canvas.Left="10.1" Canvas.Top="11.3" Width="2.0" Height="2.0" Fill="{ThemeResource PrimaryText}" />
                                            </Canvas>
                                            <Canvas x:Name="WeatherIconThunderstorm" Width="16" Height="16" Visibility="Collapsed">
                                                <Path Data="M 4.4,9.2 L 11.8,9.2 C 13.0,9.2 14.0,8.3 14.0,7.1 C 14.0,6.0 13.1,5.1 12.0,5.0 C 11.6,3.3 10.0,2.0 8.1,2.0 C 6.0,2.0 4.3,3.5 4.1,5.4 C 3.0,5.6 2.1,6.5 2.1,7.6 C 2.1,8.5 3.1,9.2 4.4,9.2 Z"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                                                <Path Data="M 8.8,9.3 L 6.6,12.1 L 8.9,12.1 L 7.2,14.8"
                                                      Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock x:Name="IdleWeatherTempBlock"
                                               Text="{Binding IdleWeatherTemperature}"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource PrimaryText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="IdleWeatherCityBlock"
                                           Text="{Binding IdleWeatherCity}"
                                           FontSize="9.5" FontWeight="Medium"
                                           LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource PrimaryText}"
                                           Opacity="0.72"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="72" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="IdleBrandPanel"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IdleBrandVisibility}">
                            <Border x:Name="IdleBrandIconBorder" Width="12" Height="12" CornerRadius="3">
                                <Image x:Name="IdleBrandIconImage" Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="12" Height="12" />
                            </Border>
                            <TextBlock x:Name="IdleBrandText"
                                       Text="PULSE"
                                       FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{ThemeResource PrimaryText}"
                                       Opacity="0.72" />
                        </StackPanel>
                    </Grid>

                    <!-- Contextual System Notification Capsule (Battery, Bluetooth, Volume, Screenshot) -->
                    <Grid x:Name="NotificationContent"
                          Visibility="{Binding NotificationVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          Background="Transparent"
                          PointerReleased="OnEventContentPointerReleased"
                          VerticalAlignment="Center">
                        <FontIcon x:Name="NotificationGlyphIcon"
                                  Grid.Column="0"
                                  Glyph="{Binding NotificationGlyph}"
                                  FontSize="15"
                                  Foreground="{ThemeResource PrimaryText}"
                                  Margin="2,0,10,0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="NotificationTitleBlock"
                                       Text="{Binding NotificationTitle}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="NotificationSubtitleBlock"
                                       Text="{Binding NotificationSubtitle}"
                                       FontSize="10.5" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>

                        <Button x:Name="NotificationDismissButton"
                                Grid.Column="2"
                                Style="{StaticResource IslandButtonStyle}"
                                Width="22" Height="22" CornerRadius="11"
                                Margin="6,0,0,0"
                                Command="{Binding DismissActiveEventCommand}"
                                PointerPressed="OnButtonPointerPressed"
                                PointerReleased="OnButtonPointerReleased"
                                AutomationProperties.Name="Bildirimi kapat"
                                ToolTipService.ToolTip="Kapat">
                            <FontIcon x:Name="NotificationDismissGlyph" Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource SecondaryText}" />
                        </Button>
                    </Grid>

                    <!-- Contextual Focus Timer Capsule (Pomodoro) -->
                    <Grid x:Name="FocusTimerContent"
                          Visibility="{Binding FocusTimerVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          Background="Transparent"
                          PointerReleased="OnCompactFocusPointerReleased"
                          ToolTipService.ToolTip="Odak panelini aç"
                          VerticalAlignment="Center">
                        <FontIcon x:Name="FocusCompactGlyphIcon"
                                  Grid.Column="0"
                                  Glyph="&#xE916;"
                                  FontSize="15"
                                  Foreground="{ThemeResource PrimaryText}"
                                  Margin="2,0,10,0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="FocusCompactTimerBlock"
                                       Text="{Binding FocusTimerText}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{ThemeResource PrimaryText}"
                                       MaxLines="1" />
                            <TextBlock x:Name="FocusCompactModeBlock"
                                       Text="{Binding FocusTimerModeText}"
                                       FontSize="10.5" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       MaxLines="1" />
                        </StackPanel>

                        <Button x:Name="FocusCompactToggleButton"
                                Grid.Column="2"
                                Style="{StaticResource IslandButtonStyle}"
                                Width="24" Height="24" CornerRadius="12"
                                Margin="6,0,0,0"
                                Command="{Binding ToggleFocusTimerCommand}"
                                PointerPressed="OnButtonPointerPressed"
                                PointerReleased="OnButtonPointerReleased"
                                AutomationProperties.Name="Odak sayacını başlat veya duraklat"
                                ToolTipService.ToolTip="Başlat / Duraklat">
                            <FontIcon x:Name="FocusCompactToggleGlyph" Glyph="{Binding FocusPlayPauseGlyph}" FontSize="11" Foreground="{ThemeResource PrimaryText}" />
                        </Button>
                    </Grid>

                    <!-- Contextual File Operation Progress Capsule -->
                    <Grid x:Name="FileOperationContent"
                          Visibility="{Binding FileOperationVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          Background="Transparent"
                          PointerReleased="OnEventContentPointerReleased"
                          ToolTipService.ToolTip="Klasörde göster"
                          VerticalAlignment="Center">
                        <FontIcon x:Name="FileOpCompactGlyphIcon"
                                  Grid.Column="0"
                                  Glyph="&#xE896;"
                                  FontSize="15"
                                  Foreground="{ThemeResource Accent}"
                                  Margin="2,0,10,0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="FileOpCompactNameBlock"
                                       Text="{Binding FileOperationName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <ProgressBar x:Name="FileOpCompactProgressBar"
                                         Value="{Binding FileOperationProgress}"
                                         Maximum="100"
                                         Height="3"
                                         Foreground="{ThemeResource Accent}"
                                         Background="{ThemeResource PillControlBackground}"
                                         CornerRadius="1.5" />
                        </StackPanel>

                        <TextBlock x:Name="FileOpCompactStatusBlock"
                                   Grid.Column="2"
                                   Text="{Binding FileOperationStatusText}"
                                   FontSize="10.5" FontWeight="Medium"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{ThemeResource SecondaryText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Active track compact -->
                    <Grid x:Name="CompactTrackContent"
                          Visibility="{Binding TrackContentVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          VerticalAlignment="Center">

                        <!-- Mini artwork -->
                        <Border x:Name="CompactArtBorder"
                                Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="7"
                                Margin="0,0,8,0"
                                Background="{ThemeResource PillControlBackground}"
                                PointerReleased="OnMediaSourcePointerReleased"
                                ToolTipService.ToolTip="Uygulamada aç">
                            <Grid x:Name="CompactArtInnerGrid" CornerRadius="7">
                                <FontIcon x:Name="CompactArtFallbackGlyph" Glyph="&#xEC4F;" FontSize="11" Foreground="{ThemeResource SecondaryText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Track title & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0.5">
                            <TextBlock x:Name="CompactTrackTitleBlock"
                                       Text="{Binding CurrentTrack.Title, TargetNullValue='Pulse'}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="CompactTrackArtistBlock"
                                       Text="{Binding CurrentTrack.Artist, TargetNullValue='Pulse'}"
                                       FontSize="9.5" FontWeight="Normal"
                                       Foreground="{ThemeResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>

                        <!-- Right items: Equalizer wave bars & Compact Play/Pause button -->
                        <StackPanel x:Name="CompactTrackRightStack"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">

                            <!-- Animated equalizer bars (revealed during hover 02) -->
                            <StackPanel x:Name="CompactWaveBars"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Opacity="0">
                                <Border x:Name="WaveBar1" Width="2.5" Height="13" CornerRadius="1.25" Background="{ThemeResource Accent}" />
                                <Border x:Name="WaveBar2" Width="2.5" Height="13" CornerRadius="1.25" Background="{ThemeResource Accent}" />
                                <Border x:Name="WaveBar3" Width="2.5" Height="13" CornerRadius="1.25" Background="{ThemeResource Accent}" />
                            </StackPanel>

                            <!-- Compact Play/Pause button -->
                            <Button x:Name="CompactPlayPauseButton"
                                    Style="{StaticResource IslandButtonStyle}"
                                    Width="24" Height="24" CornerRadius="12"
                                    Command="{Binding PlayPauseCommand}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    AutomationProperties.Name="Oynat veya duraklat"
                                    ToolTipService.ToolTip="Oynat / Duraklat">
                                <FontIcon x:Name="CompactPlayPauseGlyph" Glyph="{Binding PlayPauseGlyph}" FontSize="12" Foreground="{ThemeResource PrimaryText}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 03: EXPANDED VIEW (Fixed target layout bounds; GPU Opacity/Scale & PillMaskHost clip avoid reflow) -->
                <Grid x:Name="ExpandedView"
                      Width="384" Height="240"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      Padding="16,14,16,14"
                      PointerReleased="OnExpandedViewPointerReleased"
                      RowDefinitions="Auto,*">

                    <!-- Row 0: Dynamic Brand Badge, Centered Carousel Dots & Header Controls -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                        <!-- Left: Dynamic Badge & Panel Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Section Badges -->
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <!-- Spotify Vector Badge (shown only when Spotify owns the media session) -->
                                <Grid x:Name="MediaHeaderBadge" Visibility="{Binding SpotifyBadgeVisibility}">
                                    <Ellipse Width="22" Height="22" Fill="#1ED760" />
                                    <Canvas Width="22" Height="22">
                                        <Path Data="M 5.8,8.2 C 8.6,7.2 13.4,7.4 16.2,9.1"
                                              Stroke="#121212" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M 6.4,11.2 C 8.8,10.4 12.8,10.6 15.6,12.1"
                                              Stroke="#121212" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M 7.2,14.0 C 9.2,13.4 12.4,13.6 14.8,14.9"
                                              Stroke="#121212" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Grid>
                                <!-- Non-Spotify Monochrome Media App Badge -->
                                <Grid x:Name="GenericMediaHeaderBadge" Visibility="{Binding GenericMediaBadgeVisibility}">
                                    <Ellipse Width="22" Height="22" Fill="{ThemeResource PillControlBackground}" />
                                    <TextBlock Text="{Binding AppBadgeText}"
                                               FontSize="9.5" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Focus Timer Badge -->
                                <Grid x:Name="FocusHeaderBadge" Visibility="{Binding FocusPageVisibility}">
                                    <Ellipse Width="22" Height="22" Fill="{ThemeResource PillControlBackground}" />
                                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <!-- System Control Badge -->
                                <Grid x:Name="SystemHeaderBadge" Visibility="{Binding SystemPageVisibility}">
                                    <Ellipse Width="22" Height="22" Fill="{ThemeResource PillControlBackground}" />
                                    <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{ThemeResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <TextBlock Text="{Binding ExpandedHeaderTitle, TargetNullValue='Pulse'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="112"
                                       MaxLines="1"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- Center: True-Centered iOS-style Interactive Carousel Page Indicators -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="3"
                              Width="50" Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Border x:Name="PageDotVisual0"
                                    Width="24" Height="5"
                                    CornerRadius="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PrimaryText}"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PageDotVisual1"
                                    Width="24" Height="5"
                                    CornerRadius="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PrimaryText}"
                                    Opacity="0.35"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PageDotVisual2"
                                    Width="24" Height="5"
                                    CornerRadius="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PrimaryText}"
                                    Opacity="0.35"
                                    IsHitTestVisible="False" />

                            <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="PageDot0"
                                        Style="{StaticResource IslandButtonStyle}"
                                        Width="16" Height="24"
                                        Background="Transparent"
                                        Padding="0"
                                        PointerPressed="OnButtonPointerPressed"
                                        PointerReleased="OnButtonPointerReleased"
                                        Click="OnPageDot0Click"
                                        AutomationProperties.Name="Medya Çalar sayfası"
                                        ToolTipService.ToolTip="Medya Çalar" />
                                <Button x:Name="PageDot1"
                                        Style="{StaticResource IslandButtonStyle}"
                                        Width="16" Height="24"
                                        Background="Transparent"
                                        Padding="0"
                                        PointerPressed="OnButtonPointerPressed"
                                        PointerReleased="OnButtonPointerReleased"
                                        Click="OnPageDot1Click"
                                        AutomationProperties.Name="Odak Sayacı sayfası"
                                        ToolTipService.ToolTip="Odak Sayacı" />
                                <Button x:Name="PageDot2"
                                        Style="{StaticResource IslandButtonStyle}"
                                        Width="16" Height="24"
                                        Background="Transparent"
                                        Padding="0"
                                        PointerPressed="OnButtonPointerPressed"
                                        PointerReleased="OnButtonPointerReleased"
                                        Click="OnPageDot2Click"
                                        AutomationProperties.Name="Sistem ve Denetim sayfası"
                                        ToolTipService.ToolTip="Sistem &amp; Denetim" />
                            </StackPanel>
                        </Grid>

                        <!-- Right: Header Action Buttons (Collapse, Settings) -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                    Click="OnCollapseClick"
                                    AutomationProperties.Name="Adayı daralt"
                                    ToolTipService.ToolTip="Daralt"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                    Click="OnSettingsClick"
                                    AutomationProperties.Name="Ayarlar"
                                    ToolTipService.ToolTip="Ayarlar"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE713;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Carousel Panels Host (Media / Focus / System) -->
                    <Grid Grid.Row="1" x:Name="ExpandedPanelsHost">

                        <!-- Panel 0: Müzik & Medya -->
                        <Grid x:Name="MediaExpandedPanel" Visibility="Visible" RowDefinitions="*,Auto">
                            <!-- Existing Media Art & Metadata -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,4,0,10">
                                <!-- Square Album Art -->
                                <Border Grid.Column="0"
                                        Width="96" Height="96"
                                        CornerRadius="18"
                                        Background="{ThemeResource PillControlBackground}"
                                        BorderBrush="{ThemeResource IslandBorder}"
                                        BorderThickness="1"
                                        PointerReleased="OnMediaSourcePointerReleased"
                                        AutomationProperties.Name="Medya uygulamasını aç"
                                        ToolTipService.ToolTip="Uygulamada aç"
                                        VerticalAlignment="Center">
                                    <Grid CornerRadius="17">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource SecondaryText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Track Metadata, Progress Slider and Timestamps -->
                                <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                     <TextBlock Grid.Row="0"
                                                Text="{Binding CurrentTrack.Title, TargetNullValue='Müzik başlatın'}"
                                                FontSize="19" FontWeight="SemiBold"
                                                Foreground="{ThemeResource PrimaryText}"
                                                TextTrimming="CharacterEllipsis" MaxLines="1" />

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding CurrentTrack.Artist, TargetNullValue='Pulse'}"
                                               FontSize="13.5" FontWeight="Normal"
                                               Foreground="{ThemeResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Margin="0,2,0,6" />

                                    <controls:PulseSeekBar Grid.Row="2"
                                                           x:Name="ExpandedSeekBar"
                                                           Height="22"
                                                           Value="{Binding SeekPercent, Mode=TwoWay}"
                                                           CanSeek="{Binding CurrentTrack.CanSeek, FallbackValue=True}"
                                                           AccentBrush="{ThemeResource SeekAccent}"
                                                           Visibility="{Binding SeekPanelVisibility}"
                                                           ScrubStarted="OnSeekBarScrubStarted"
                                                           ScrubDelta="OnSeekBarScrubDelta"
                                                           ScrubCompleted="OnSeekBarScrubCompleted" />

                                    <Grid Grid.Row="3" Margin="1,1,1,0" Visibility="{Binding SeekPanelVisibility}">
                                        <TextBlock Text="{Binding PositionLabel}"
                                                   FontSize="10.5" FontWeight="Medium"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource SecondaryText}"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding DurationLabel}"
                                                   FontSize="10.5" FontWeight="Medium"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource SecondaryText}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Synced lyrics: current line + upcoming line -->
                                    <StackPanel Grid.Row="4" Margin="1,4,1,4" Spacing="0"
                                                Visibility="{Binding LyricsVisibility}">
                                        <TextBlock Text="{Binding CurrentLyricLine}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{ThemeResource PrimaryText}"
                                                   Opacity="0.92"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <TextBlock Text="{Binding NextLyricLine}"
                                                   FontSize="9"
                                                   Foreground="{ThemeResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Media Transport Controls (Apple live-activity layout: bare glyphs, filled play) -->
                            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                    <Button Style="{StaticResource TransportNavButtonStyle}"
                                            Width="32" Height="32" CornerRadius="16"
                                            Command="{Binding SeekBackwardCommand}"
                                            IsEnabled="{Binding CurrentTrack.CanSeek}"
                                            Visibility="{Binding SeekPanelVisibility}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="15 saniye geri sar"
                                            ToolTipService.ToolTip="15 sn geri">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 10,2.5 A 7.5,7.5 0 1,0 17,10.5 M 10,2.5 L 12.4,0.1 M 10,2.5 L 12.4,4.9"
                                                  Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="-15" FontSize="6.5" FontWeight="Bold"
                                                       Foreground="{ThemeResource PrimaryText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,0.5,0,0" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource TransportNavButtonStyle}"
                                            Command="{Binding PreviousCommand}"
                                            IsEnabled="{Binding CanGoPrevious}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Önceki parça"
                                            ToolTipService.ToolTip="Önceki">
                                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                                    </Button>

                                    <Button Style="{StaticResource PlayPauseButtonStyle}"
                                            Command="{Binding PlayPauseCommand}"
                                            IsEnabled="{Binding CanTogglePlayback}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Oynat veya duraklat"
                                            ToolTipService.ToolTip="Oynat / Duraklat">
                                        <FontIcon Glyph="{Binding PlayPauseGlyph}" FontSize="18" />
                                    </Button>

                                    <Button Style="{StaticResource TransportNavButtonStyle}"
                                            Command="{Binding NextCommand}"
                                            IsEnabled="{Binding CanGoNext}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Sonraki parça"
                                            ToolTipService.ToolTip="Sonraki">
                                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                                    </Button>

                                    <Button Style="{StaticResource TransportNavButtonStyle}"
                                            Width="32" Height="32" CornerRadius="16"
                                            Command="{Binding SeekForwardCommand}"
                                            IsEnabled="{Binding CurrentTrack.CanSeek}"
                                            Visibility="{Binding SeekPanelVisibility}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="15 saniye ileri sar"
                                            ToolTipService.ToolTip="15 sn ileri">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 10,2.5 A 7.5,7.5 0 1,1 3,10.5 M 10,2.5 L 7.6,0.1 M 10,2.5 L 7.6,4.9"
                                                  Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="+15" FontSize="6.5" FontWeight="Bold"
                                                       Foreground="{ThemeResource PrimaryText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,0.5,0,0" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Panel 1: Odak Sayacı (Pomodoro) -->
                        <Grid x:Name="FocusExpandedPanel" Visibility="Collapsed" RowDefinitions="*,Auto,Auto" Margin="0,4,0,8">
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding FocusTimerModeText, TargetNullValue='Odaklanma'}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SecondaryText}"
                                           CharacterSpacing="200"
                                           HorizontalAlignment="Center" />
                                <Button Style="{StaticResource IslandButtonStyle}"
                                        CornerRadius="12" Padding="14,2"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ToggleCustomFocusEditorCommand}"
                                        AutomationProperties.Name="Özel odak süresi ayarla"
                                        ToolTipService.ToolTip="Süre seç (özel süre)">
                                    <TextBlock Text="{Binding FocusTimerText, TargetNullValue='25:00'}"
                                               FontSize="38" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource PrimaryText}"
                                               MinWidth="180"
                                               TextAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <!-- Progress hairline: iOS-style thin scrubber under the timer -->
                            <Grid x:Name="FocusProgressTrack" Grid.Row="1" Height="3" Margin="24,10,24,16" CornerRadius="1.5"
                                  Background="{ThemeResource PillControlBackground}">
                                <Rectangle x:Name="FocusProgressFill"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Width="0"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{ThemeResource PrimaryText}" />
                            </Grid>

                            <!-- Presets & Actions -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                            Visibility="{Binding PresetsVisibility}">
                                    <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                            Content="25 dk" FontSize="10.5"
                                            Width="50" Height="30" CornerRadius="15"
                                            Background="{Binding FocusPreset25Brush}"
                                            Command="{Binding SetFocusTimer25Command}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            ToolTipService.ToolTip="25 Dakika Odaklanma" />
                                    <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                            Content="50 dk" FontSize="10.5"
                                            Width="50" Height="30" CornerRadius="15"
                                            Background="{Binding FocusPreset50Brush}"
                                            Command="{Binding SetFocusTimer50Command}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            ToolTipService.ToolTip="50 Dakika Derin Çalışma" />
                                    <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                            Content="5 dk" FontSize="10.5"
                                            Width="50" Height="30" CornerRadius="15"
                                            Background="{Binding BreakPreset5Brush}"
                                            Command="{Binding SetBreakTimer5Command}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            ToolTipService.ToolTip="5 Dakika Kısa Mola" />
                                    <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                            Content="15 dk" FontSize="10.5"
                                            Width="50" Height="30" CornerRadius="15"
                                            Background="{Binding BreakPreset15Brush}"
                                            Command="{Binding SetBreakTimer15Command}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            ToolTipService.ToolTip="15 Dakika Uzun Mola" />
                                </StackPanel>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            Visibility="{Binding CustomEditorVisibility}">
                                    <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                            Width="30" Height="30" CornerRadius="15"
                                            Command="{Binding CustomFocusMinusCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="5 dakika azalt"
                                            ToolTipService.ToolTip="5 dakika azalt">
                                        <FontIcon Glyph="&#xE738;" FontSize="10" />
                                    </Button>
                                    <TextBlock Text="{Binding CustomFocusMinutesLabel}"
                                               MinWidth="44" TextAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource PrimaryText}" />
                                    <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                            Width="30" Height="30" CornerRadius="15"
                                            Command="{Binding CustomFocusPlusCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="5 dakika artır"
                                            ToolTipService.ToolTip="5 dakika artır">
                                        <FontIcon Glyph="&#xE710;" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                            Content="Başlat" FontSize="10.5"
                                            Width="56" Height="30" CornerRadius="15"
                                            Background="{ThemeResource PillControlBackground}"
                                            Foreground="{ThemeResource PrimaryText}"
                                            Command="{Binding StartCustomFocusCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Özel süreyle odak sayacını başlat"
                                            ToolTipService.ToolTip="Özel süreyle başlat" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                            Width="32" Height="32" CornerRadius="16"
                                            Command="{Binding ResetFocusTimerCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Odak sayacını sıfırla"
                                            ToolTipService.ToolTip="Sıfırla">
                                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource PlayPauseButtonStyle}"
                                            Width="38" Height="38" CornerRadius="19"
                                            Background="{ThemeResource PrimaryText}"
                                            Foreground="{ThemeResource IslandSolidSurface}"
                                            Command="{Binding ToggleFocusTimerCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Odak sayacını başlat veya duraklat"
                                            ToolTipService.ToolTip="Başlat / Duraklat">
                                        <FontIcon Glyph="{Binding FocusPlayPauseGlyph}" FontSize="14"
                                                  Foreground="{ThemeResource IslandSolidSurface}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Panel 2: Sistem & Denetim (flat, Apple Control Center feel — no cards) -->
                        <Grid x:Name="SystemExpandedPanel" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Spacing="14" Margin="6,0">
                                <!-- Volume row (flat Apple Control Center style) -->
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IslandButtonStyle}"
                                            Width="30" Height="30" CornerRadius="15"
                                            Background="Transparent"
                                            Command="{Binding SystemToggleMuteCommand}"
                                            Margin="0,0,12,0"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Sesi kapat veya aç"
                                            ToolTipService.ToolTip="Sesi Kapat / Aç">
                                        <FontIcon Glyph="{Binding SystemMuteGlyph}"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource PrimaryText}" />
                                    </Button>

                                    <Slider x:Name="SystemVolumeSlider"
                                            Grid.Column="1"
                                            Value="{Binding MasterVolume, Mode=TwoWay}"
                                            Minimum="0" Maximum="100" StepFrequency="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Ses düzeyi" />
                                </Grid>

                                <!-- Battery + quick capture row -->
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                Visibility="{Binding BatteryVisibility}">
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding BatteryGlyph}" FontSize="14"
                                                      Foreground="{Binding BatteryIconBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding BatterySummary}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource PrimaryText}"
                                                   VerticalAlignment="Center" />
                                        <Grid Width="9" Height="9" VerticalAlignment="Center"
                                              Visibility="{Binding BatteryChargingVisibility}">
                                            <Ellipse x:Name="BatteryChargeHalo"
                                                     Width="9" Height="9"
                                                     Fill="{Binding BatteryStatusBrush}"
                                                     Opacity="0.18" />
                                            <Ellipse Width="4" Height="4"
                                                     Fill="{Binding BatteryStatusBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource CircularHeaderButtonStyle}"
                                            Width="32" Height="32" CornerRadius="16"
                                            HorizontalAlignment="Right"
                                            Command="{Binding TakeScreenshotCommand}"
                                            PointerPressed="OnButtonPointerPressed"
                                            PointerReleased="OnButtonPointerReleased"
                                            AutomationProperties.Name="Ekran görüntüsü al"
                                            ToolTipService.ToolTip="Ekran Görüntüsü Al (Görüntü panoya kopyalanır ve Ekran Görüntüleri klasörüne kaydedilir)">
                                        <FontIcon Glyph="&#xE722;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Trailing Detached Capsule for Secondary Contextual Events (Apple Split Island) -->
        <Border x:Name="DetachedPill"
                Width="66" Height="40"
                CornerRadius="20"
                Margin="0,3,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource IslandBackground}"
                BorderBrush="{ThemeResource IslandBorder}"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                PointerEntered="OnDetachedPillPointerEntered"
                PointerExited="OnDetachedPillPointerExited"
                PointerPressed="OnDetachedPillPointerPressed"
                PointerReleased="OnDetachedPillPointerReleased"
                AutomationProperties.Name="{Binding DetachedToolTip}"
                ToolTipService.ToolTip="{Binding DetachedToolTip}">

            <Grid x:Name="DetachedInnerGrid" CornerRadius="19">
                <Rectangle x:Name="DetachedFrostLayer"
                           Visibility="Collapsed"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsHitTestVisible="False" />

                <Rectangle x:Name="DetachedFrostTintLayer"
                           Visibility="Collapsed"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsHitTestVisible="False" />

                <Rectangle x:Name="DetachedFrostSheen"
                           Height="16"
                           Visibility="Collapsed"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="DetachedFrostSheenTopStop" Color="#2EFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel x:Name="DetachedInnerStack"
                            Orientation="Horizontal" Spacing="3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="4,0,4,0">
                    <FontIcon x:Name="DetachedGlyphIcon"
                              Glyph="{Binding DetachedGlyph}"
                              FontSize="11"
                              Foreground="{ThemeResource PrimaryText}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="DetachedBadgeTextBlock"
                               Text="{Binding DetachedBadgeText}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PrimaryText}"
                               VerticalAlignment="Center"
                               MaxLines="1" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
