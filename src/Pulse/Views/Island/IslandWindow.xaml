<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Pulse.Views.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pulse.Controls"
    xmlns:winuiex="using:WinUIEx"
    Title="Pulse Dynamic Island">

    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop TintColor="Transparent" />
    </Window.SystemBackdrop>

    <!--
        WindowRoot: transparent root container.
        No background brush is set so clicks outside the Surface element
        pass directly to the underlying windows and desktop.
    -->
    <Grid x:Name="WindowRoot"
          Background="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">

        <Grid.Resources>
            <!-- Default Apple Dark Mode palette -->
            <SolidColorBrush x:Key="IslandBackground" Color="#FF18181B" />
            <SolidColorBrush x:Key="IslandBorder"     Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="PrimaryText"      Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryText"    Color="#A0EBEBEB" />
            <SolidColorBrush x:Key="Accent"           Color="#FF1DB954" />
            <SolidColorBrush x:Key="SeekAccent"       Color="#FF1DB954" />
            <SolidColorBrush x:Key="PlayButtonBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PlayButtonForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="PillControlBackground" Color="#1AFFFFFF" />

            <!-- Clean button style: no chrome, no focus border -->
            <Style x:Key="IslandButtonStyle" TargetType="Button">
                <Setter Property="Background"           Value="Transparent" />
                <Setter Property="Foreground"           Value="{ThemeResource SecondaryText}" />
                <Setter Property="BorderThickness"      Value="0" />
                <Setter Property="Padding"              Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Transport controls -->
            <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="38" />
                <Setter Property="Height"       Value="38" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="FontSize"     Value="15" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>
        </Grid.Resources>

        <!-- Micro notch anchor shown when island is hidden -->
        <Border x:Name="HiddenAnchor"
                Width="48" Height="6"
                CornerRadius="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Background="{ThemeResource IslandBorder}"
                Opacity="0.6"
                Visibility="Collapsed"
                PointerEntered="OnHiddenAnchorPointerEntered"
                PointerReleased="OnHiddenAnchorPointerReleased">
            <ToolTipService.ToolTip>
                <ToolTip Content="Pulse Dynamic Island'ı Göster" />
            </ToolTipService.ToolTip>
        </Border>

        <!-- Dynamic Island Surface Pill / Card -->
        <Border x:Name="Surface"
                Width="216" Height="38"
                CornerRadius="19"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource IslandBackground}"
                BorderBrush="{ThemeResource IslandBorder}"
                BorderThickness="0.5"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerReleased="OnSurfacePointerReleased">

            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Genişlet / Daralt" Click="OnToggleExpandedClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Adayı Gizle" Click="OnHideIslandClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Görev Çubuğu Paneli" Click="OnOpenTaskbarFlyoutClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ayarlar" Click="OnSettingsClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <!-- COMPACT VIEW (Capsule mode) -->
                <Grid x:Name="CompactView"
                      Opacity="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="8,0,10,0">

                    <!-- Idle: no active track -->
                    <Grid x:Name="IdleContent"
                          Visibility="{Binding IdleVisibility}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource Accent}" />
                            <TextBlock Text="PULSE"
                                       FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{ThemeResource SecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Active track compact -->
                    <Grid x:Name="CompactTrackContent"
                          Visibility="{Binding CompactVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          VerticalAlignment="Center">

                        <!-- Mini artwork with fallback placeholder -->
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="7"
                                Margin="0,0,8,0"
                                Background="{ThemeResource PillControlBackground}">
                            <Grid CornerRadius="7">
                                <FontIcon Glyph="&#xEC4F;" FontSize="11" Foreground="{ThemeResource SecondaryText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Track title -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentTrack.Title, TargetNullValue='Pulse'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />

                        <!-- Animated GPU equalizer bars -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2.5"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Border x:Name="WaveBar1" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                            <Border x:Name="WaveBar2" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                            <Border x:Name="WaveBar3" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- EXPANDED VIEW (Rich Apple Dynamic Island Media Player) -->
                <Grid x:Name="ExpandedView"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Padding="16,12,16,14"
                      PointerReleased="OnExpandedViewPointerReleased"
                      RowDefinitions="Auto,Auto,Auto,Auto">

                    <!-- Row 0: App Source Badge & Header Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Grid Width="16" Height="16">
                                <Ellipse Width="16" Height="16" Fill="{ThemeResource Accent}" />
                                <FontIcon Glyph="&#xE8D6;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding AppDisplayName, TargetNullValue='Pulse'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SecondaryText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Actions: Collapse, Hide, Settings -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource IslandButtonStyle}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Click="OnCollapseClick"
                                    ToolTipService.ToolTip="Daralt"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource IslandButtonStyle}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Click="OnHideIslandClick"
                                    ToolTipService.ToolTip="Gizle"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xED1A;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource IslandButtonStyle}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Click="OnSettingsClick"
                                    ToolTipService.ToolTip="Ayarlar"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE713;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Large Artwork & Track Info -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                        <!-- High-resolution album artwork with fallback icon -->
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="14"
                                Background="{ThemeResource PillControlBackground}">
                            <Grid CornerRadius="14">
                                <FontIcon Glyph="&#xEC4F;" FontSize="22" Foreground="{ThemeResource SecondaryText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Title and artist stack -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="3">
                            <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue='Müzik başlatın'}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue='Pulse'}"
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Live interactive seekbar & timestamps -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:PulseSeekBar Grid.Row="0"
                                               x:Name="ExpandedSeekBar"
                                               Height="18"
                                               Value="{Binding SeekPercent, Mode=TwoWay}"
                                               CanSeek="{Binding CurrentTrack.CanSeek, FallbackValue=True}"
                                               AccentBrush="{ThemeResource SeekAccent}"
                                               Visibility="{Binding SeekPanelVisibility}"
                                               ScrubStarted="OnSeekBarScrubStarted"
                                               ScrubDelta="OnSeekBarScrubDelta"
                                               ScrubCompleted="OnSeekBarScrubCompleted" />

                        <Grid Grid.Row="1" Margin="2,-2,2,0">
                            <TextBlock Text="{Binding PositionLabel}"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DurationLabel}"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <!-- Row 3: Balanced transport controls -->
                    <Grid Grid.Row="3" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Content="−15" FontSize="11" FontWeight="SemiBold"
                                    Command="{Binding SeekBackwardCommand}"
                                    IsEnabled="{Binding CurrentTrack.CanSeek}"
                                    Visibility="{Binding SeekPanelVisibility}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="15 sn geri" />

                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Command="{Binding PreviousCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="Önceki">
                                <FontIcon Glyph="&#xE892;" FontSize="15" />
                            </Button>

                            <!-- Prominent circular play/pause button -->
                            <Button Width="46" Height="46" CornerRadius="23"
                                    Background="{ThemeResource PlayButtonBackground}"
                                    Foreground="{ThemeResource PlayButtonForeground}"
                                    BorderThickness="0"
                                    Command="{Binding PlayPauseCommand}"
                                    IsEnabled="{Binding CanTogglePlayback}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="Oynat / Duraklat">
                                <FontIcon Glyph="{Binding PlayPauseGlyph}" FontSize="16" />
                            </Button>

                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanGoNext}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="Sonraki">
                                <FontIcon Glyph="&#xE893;" FontSize="15" />
                            </Button>

                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Content="+15" FontSize="11" FontWeight="SemiBold"
                                    Command="{Binding SeekForwardCommand}"
                                    IsEnabled="{Binding CurrentTrack.CanSeek}"
                                    Visibility="{Binding SeekPanelVisibility}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="15 sn ileri" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
