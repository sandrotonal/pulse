<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Pulse.Views.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pulse.Controls"
    xmlns:winuiex="using:WinUIEx"
    Title="Pulse Dynamic Island">

    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop TintColor="Transparent" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot"
          Background="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">

        <Grid.Resources>
            <!-- Reference Dark Glass palette -->
            <SolidColorBrush x:Key="IslandBackground" Color="#EE111724" />
            <SolidColorBrush x:Key="IslandBorder"     Color="#2CFFFFFF" />
            <SolidColorBrush x:Key="PrimaryText"      Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryText"    Color="#FF8E95A2" />
            <SolidColorBrush x:Key="Accent"           Color="#FF007AFF" />
            <SolidColorBrush x:Key="SeekAccent"       Color="#FF007AFF" />
            <SolidColorBrush x:Key="PlayButtonBackground" Color="#FF007AFF" />
            <SolidColorBrush x:Key="PlayButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PillControlBackground" Color="#1EFFFFFF" />

            <!-- Clean base button style -->
            <Style x:Key="IslandButtonStyle" TargetType="Button">
                <Setter Property="Background"           Value="Transparent" />
                <Setter Property="Foreground"           Value="{ThemeResource SecondaryText}" />
                <Setter Property="BorderThickness"      Value="0" />
                <Setter Property="Padding"              Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{TemplateBinding Background}"
                                Foreground="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular header button style -->
            <Style x:Key="CircularHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="28" />
                <Setter Property="Height"       Value="28" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background"   Value="{ThemeResource PillControlBackground}" />
                <Setter Property="Foreground"   Value="{ThemeResource SecondaryText}" />
            </Style>

            <!-- Transport capsule button style (-15 and +15) -->
            <Style x:Key="TransportCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="50" />
                <Setter Property="Height"       Value="34" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Background"   Value="{ThemeResource PillControlBackground}" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>

            <!-- Transport navigation button style (Previous / Next) -->
            <Style x:Key="TransportNavButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="36" />
                <Setter Property="Height"       Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background"   Value="Transparent" />
                <Setter Property="Foreground"   Value="{ThemeResource PrimaryText}" />
            </Style>

            <!-- Play/Pause circular button style -->
            <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandButtonStyle}">
                <Setter Property="Width"        Value="50" />
                <Setter Property="Height"       Value="50" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="Background"   Value="{ThemeResource PlayButtonBackground}" />
                <Setter Property="Foreground"   Value="{ThemeResource PlayButtonForeground}" />
            </Style>
        </Grid.Resources>

        <!-- Micro notch anchor shown when island is hidden -->
        <Border x:Name="HiddenAnchor"
                Width="48" Height="6"
                CornerRadius="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Background="{ThemeResource IslandBorder}"
                Opacity="0.6"
                Visibility="Collapsed"
                PointerEntered="OnHiddenAnchorPointerEntered"
                PointerReleased="OnHiddenAnchorPointerReleased">
            <ToolTipService.ToolTip>
                <ToolTip Content="Pulse Dynamic Island'ı Göster" />
            </ToolTipService.ToolTip>
        </Border>

        <!-- Dynamic Island Surface Pill / Card -->
        <Border x:Name="Surface"
                Width="216" Height="38"
                CornerRadius="19"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource IslandBackground}"
                BorderBrush="{ThemeResource IslandBorder}"
                BorderThickness="1"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerReleased="OnSurfacePointerReleased">

            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Genişlet / Daralt" Click="OnToggleExpandedClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Adayı Gizle" Click="OnHideIslandClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Görev Çubuğu Paneli" Click="OnOpenTaskbarFlyoutClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ayarlar" Click="OnSettingsClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <!-- COMPACT VIEW (Capsule mode: 216 x 38) -->
                <Grid x:Name="CompactView"
                      Opacity="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="8,0,10,0">

                    <!-- Idle: no active track -->
                    <Grid x:Name="IdleContent"
                          Visibility="{Binding IdleVisibility}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource Accent}" />
                            <TextBlock Text="PULSE"
                                       FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{ThemeResource SecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Active track compact -->
                    <Grid x:Name="CompactTrackContent"
                          Visibility="{Binding CompactVisibility}"
                          ColumnDefinitions="Auto,*,Auto"
                          VerticalAlignment="Center">

                        <!-- Mini artwork -->
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="7"
                                Margin="0,0,8,0"
                                Background="{ThemeResource PillControlBackground}">
                            <Grid CornerRadius="7">
                                <FontIcon Glyph="&#xEC4F;" FontSize="11" Foreground="{ThemeResource SecondaryText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Track title -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentTrack.Title, TargetNullValue='Pulse'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />

                        <!-- Animated equalizer bars -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2.5"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Border x:Name="WaveBar1" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                            <Border x:Name="WaveBar2" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                            <Border x:Name="WaveBar3" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource Accent}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- EXPANDED VIEW (Reference-Driven Apple Dynamic Island Media Card) -->
                <Grid x:Name="ExpandedView"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Padding="22,14,22,16"
                      PointerReleased="OnExpandedViewPointerReleased"
                      RowDefinitions="Auto,Auto,Auto,Auto">

                    <!-- Row 0: App Source Badge & Header Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Authentic Spotify Logo -->
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="#FF1DB954" />
                                <Path Data="M 4.5,6.5 C 7.5,5.5 11.5,5.8 13.8,7.2 M 5,9 C 7.5,8.2 11,8.4 13.2,9.6 M 5.5,11.5 C 7.5,10.8 10,11 11.8,12"
                                      Stroke="#FF000000" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock Text="{Binding AppDisplayName, TargetNullValue='Spotify'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE1E4EA"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Header Actions: Collapse, Hide, Settings -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                    Click="OnCollapseClick"
                                    ToolTipService.ToolTip="Daralt"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                    Click="OnHideIslandClick"
                                    ToolTipService.ToolTip="Gizle"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xED1A;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CircularHeaderButtonStyle}"
                                    Click="OnSettingsClick"
                                    ToolTipService.ToolTip="Ayarlar"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased">
                                <FontIcon Glyph="&#xE713;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Album Artwork + Track Details -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                        <!-- Square Album Art -->
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="14"
                                Background="#1C232D">
                            <Grid CornerRadius="14">
                                <FontIcon Glyph="&#xEC4F;" FontSize="24" Foreground="{ThemeResource SecondaryText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Title and Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="3">
                            <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue='Müzik başlatın'}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{ThemeResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue='Pulse'}"
                                       FontSize="14"
                                       Foreground="{ThemeResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Scrubber & Timestamps -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:PulseSeekBar Grid.Row="0"
                                               x:Name="ExpandedSeekBar"
                                               Height="18"
                                               Value="{Binding SeekPercent, Mode=TwoWay}"
                                               CanSeek="{Binding CurrentTrack.CanSeek, FallbackValue=True}"
                                               AccentBrush="{ThemeResource SeekAccent}"
                                               Visibility="{Binding SeekPanelVisibility}"
                                               ScrubStarted="OnSeekBarScrubStarted"
                                               ScrubDelta="OnSeekBarScrubDelta"
                                               ScrubCompleted="OnSeekBarScrubCompleted" />

                        <Grid Grid.Row="1" Margin="1,-2,1,0">
                            <TextBlock Text="{Binding PositionLabel}"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DurationLabel}"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{ThemeResource SecondaryText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <!-- Row 3: Reference Transport Controls -->
                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Seek Backward 15s Capsule -->
                            <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                    Command="{Binding SeekBackwardCommand}"
                                    IsEnabled="{Binding CurrentTrack.CanSeek}"
                                    Visibility="{Binding SeekPanelVisibility}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    Margin="0,0,14,0"
                                    ToolTipService.ToolTip="15 sn geri">
                                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 11,3 A 8,8 0 1,0 18.5,11 M 11,3 L 8.5,0.5 M 11,3 L 8.5,5.5"
                                          Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Text="-15" FontSize="7" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0.5,0,0" />
                                </Grid>
                            </Button>

                            <!-- Previous Track Button -->
                            <Button Style="{StaticResource TransportNavButtonStyle}"
                                    Command="{Binding PreviousCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    Margin="0,0,14,0"
                                    ToolTipService.ToolTip="Önceki">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>

                            <!-- Glowing Circular Play/Pause Button -->
                            <Button Style="{StaticResource PlayPauseButtonStyle}"
                                    Command="{Binding PlayPauseCommand}"
                                    IsEnabled="{Binding CanTogglePlayback}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    Margin="0,0,14,0"
                                    ToolTipService.ToolTip="Oynat / Duraklat">
                                <FontIcon Glyph="{Binding PlayPauseGlyph}" FontSize="18" />
                            </Button>

                            <!-- Next Track Button -->
                            <Button Style="{StaticResource TransportNavButtonStyle}"
                                    Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanGoNext}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    Margin="0,0,14,0"
                                    ToolTipService.ToolTip="Sonraki">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>

                            <!-- Seek Forward 15s Capsule -->
                            <Button Style="{StaticResource TransportCapsuleButtonStyle}"
                                    Command="{Binding SeekForwardCommand}"
                                    IsEnabled="{Binding CurrentTrack.CanSeek}"
                                    Visibility="{Binding SeekPanelVisibility}"
                                    PointerPressed="OnButtonPointerPressed"
                                    PointerReleased="OnButtonPointerReleased"
                                    ToolTipService.ToolTip="15 sn ileri">
                                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 11,3 A 8,8 0 1,1 3.5,11 M 11,3 L 13.5,0.5 M 11,3 L 13.5,5.5"
                                          Stroke="{ThemeResource PrimaryText}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Text="+15" FontSize="7" FontWeight="Bold"
                                               Foreground="{ThemeResource PrimaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0.5,0,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
